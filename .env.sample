# Web UI and HTTP API ports
SERVER_PORT=8081
PORT=8080
# The folder to organize, fixed at start-up; nothing outside it is read or moved.
# ./workspace is the sample copy from the quick start; use an absolute path for your own folder.
ORGANIZE_ROOT=./workspace
# The measured setting: Qwen3.5 9B 4-bit, 8K context, pinned to the measured file's commit.
LLM_REPO=unsloth/Qwen3.5-9B-GGUF
LLM_GGUF=Qwen3.5-9B-Q4_K_M.gguf
LLM_REVISION=3885219b6810b007914f3a7950a8d1b469d598a5
LLM_N_CTX=8192
# Lighter, but usable on fewer than half of the unseen folders (README section 6):
# LLM_REPO=unsloth/Qwen3.5-2B-GGUF
# LLM_GGUF=Qwen3.5-2B-Q4_K_M.gguf
# LLM_REVISION=f6d5376be1edb4d416d56da11e5397a961aca8ae
# Sampling from the Qwen3.5 model card. PyPI model-compose 0.4.120 does not pass these two to llama.cpp.
LLM_PRESENCE_PENALTY=1.5
LLM_MIN_P=0
